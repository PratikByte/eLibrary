# Docker Hub account and version tag for all eLibrary images.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=0.1.0

# Local Windows test defaults. Set these to the Ubuntu laptop's Wi-Fi IP
# before building images for deployment to Ubuntu.
UBUNTU_LAN_IP=127.0.0.1
PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3001

# Replace every placeholder in your private .env file. Never commit .env.
POSTGRES_USER=elibrary
POSTGRES_PASSWORD=replace-"Loki@123#Wallet@1245L"
MONGO_ROOT_USER=elibrary_admin
MONGO_ROOT_PASSWORD=replace-"DSffee3433###@@@@^^$$$^664ggdgd*&6666"
# Set to a unique, randomly generated secret before using Docker Compose.
JWT_SIGNING_KEY=
IDENTITY_ADMIN_PASSWORD="Loki@123#Wallet@1245L"
